# Copy to .env and fill in real values. Never commit .env.

PORT=3000

# Set to "true" only if OpenDockWatch sits behind a reverse proxy (nginx, etc.) that you
# control and that terminates TLS / sets X-Forwarded-For itself. This makes Express trust
# the incoming X-Forwarded-For header for req.ip (needed for the session cookie's Secure
# flag and for the login rate limiter to see real client IPs) and marks the session cookie
# Secure. Leave unset/false if OpenDockWatch is reachable directly - otherwise a client can
# spoof X-Forwarded-For to get a fresh "IP" on every request, defeating the login rate
# limiter and forging the IP in auth.failure log lines.
TRUST_PROXY=

# Session cookie signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Login credentials for the OpenDockWatch UI
AUTH_USER=admin
# Generate with: npm run hash-password -- "your-password-here"
AUTH_PASS_HASH=

# Optional: a second, read-only login - can view everything (containers,
# stats, logs, topology, alerts) but cannot start/stop/restart containers.
# Leave both blank to disable. Generate the hash the same way as AUTH_PASS_HASH.
VIEWER_USER=
VIEWER_PASS_HASH=

# How long to keep collected data before it's pruned (days)
METRICS_RETENTION_DAYS=7
EVENTS_RETENTION_DAYS=30

# Optional: which tab the app lands on right after login, for every user regardless of
# role - one of list / flow / logs / activity. Defaults to list if unset or invalid. Can
# also be set (and changed without a restart) from the UI's Settings panel's General tab
# (admin only) - a value saved there always overrides this.
DEFAULT_VIEW=

# Optional: webhook for alerts (container crashed / crash-looping / unhealthy / host unreachable).
# The destination and payload format are picked from ALERT_WEBHOOK_URL's scheme:
#   discord://<webhook_id>/<webhook_token>
#   ntfy://<server>/<topic>       e.g. ntfy://ntfy.sh/mytopic, or a self-hosted host
#   gotify://<host>/<token>       (http)
#   gotifys://<host>/<token>      (https)
#   https://hooks.slack.com/...   (Slack incoming webhook - auto-detected)
#   any other http(s) URL         generic JSON POST of the alert object
# ALERT_WEBHOOK_FORMAT=slack forces the Slack {text} payload for a plain http(s)
# URL that isn't hooks.slack.com (e.g. a Slack-compatible Mattermost webhook).
# Can also be set (and changed without a restart) from the UI's Settings panel
# (admin only) - a value saved there always overrides these two.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=

# Optional: resource-threshold alerts (container/host CPU %, container/host mem %,
# Docker's own disk footprint). Each fires once a sample stays over threshold for
# ALERT_SUSTAIN_MINUTES (shared between the CPU and mem rules, since both are read
# from the same stats poll) - a single spike (image build, cron job, JVM startup)
# isn't enough. Leave a threshold blank or 0 to disable that rule; all four ship
# disabled. CPU % is raw `docker stats` CPU (per-core cumulative - 4 cores fully
# busy reads 400%). Docker disk usage is `docker system df`'s total Size across all
# rows - Docker's own footprint, not host filesystem free space, so it's a prune
# reminder rather than a disk-full alert. Skip a single container entirely with the
# `opendockwatch.alerts=off` container label. Can also be set (and changed without a
# restart) from the UI's Settings panel (admin only), same override rules as the
# webhook above.
ALERT_CPU_THRESHOLD=
ALERT_MEM_THRESHOLD=
ALERT_SUSTAIN_MINUTES=5
ALERT_DISK_THRESHOLD_GB=

# Shared secret required to scrape GET /metrics (Prometheus), sent as either
# `Authorization: Bearer <token>` or `?token=<token>`. Leaving this blank does NOT
# publish /metrics without auth - it doesn't publish it at all, and the endpoint
# answers 404. That response lists every container name, compose project and usage
# figure across every host, so it's opt-in rather than on-by-default.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Stability / recovery. All optional - the defaults are what you want unless
# you're deliberately tuning for a very slow or very large host.
# ---------------------------------------------------------------------------

# The failure mode these exist for: the process is still alive and still serving
# pages, but the metrics poll loop has stopped turning, so every number on screen
# is frozen at whatever moment it wedged. Docker can't spot that on its own -
# `restart: unless-stopped` reacts to the process *exiting*, and a failing
# HEALTHCHECK marks a container unhealthy but never restarts it. So the app
# watches itself: after WATCHDOG_STALE_MS with no poll completing it reports
# unhealthy on /healthz, and if that persists for WATCHDOG_EXIT_AFTER_MS it exits,
# letting the restart policy bring back a working process. Staleness is measured
# on the loop, not on Docker - an unreachable host still completes its poll - so a
# host being down can never trigger this. Set WATCHDOG_STALE_MS very high to
# effectively disable the self-restart. Worst-case recovery is the two added
# together - 4 minutes by default, of which the first 2 are spent making sure
# this is a wedge and not just a slow poll cycle. A host suspending (laptop
# sleep) is told apart from a wedge by comparing the wall and monotonic clocks,
# so waking the machine never restarts a healthy process or flaps the
# healthcheck, however long it was away.
WATCHDOG_STALE_MS=120000
WATCHDOG_EXIT_AFTER_MS=120000

# A single event-loop stall at least this long gets its own log line. Anything
# above 250ms is counted regardless and reported once a minute as a
# watchdog.lag_summary - a host losing minutes an hour to stalls that are each
# individually small is the pattern that matters, and one threshold can't show
# both. Neither affects the restart logic; this is diagnostics only.
WATCHDOG_LAG_WARN_MS=2000

# How long an API request may take before it's answered with 504 instead of left
# hanging. A browser allows only ~6 connections per origin over HTTP/1.1 and this
# app holds some of them open permanently for its SSE streams, so a request that
# never answers is a connection slot lost - enough of them and the tab can't issue
# any request at all and looks frozen. Must stay above the longest docker call
# (30s, a container stop waiting out SIGTERM). SSE streams are exempt.
REQUEST_TIMEOUT_MS=50000

# Observability. These change nothing about how the app behaves - they exist so
# that "it hung for a few minutes and then came back" leaves a trace instead of
# a blank stretch of log.
#
# app.vitals is a heartbeat: one INFO line on this interval carrying memory,
# event-loop lag, the last/worst poll duration, the docker queue depth, and how
# many log/event streams are held. Most of its value is that it is periodic - a
# gap in the heartbeats is itself the evidence that the process stalled, and the
# lines either side show the state going in and coming back out. Set to 0 to
# turn it off entirely.
VITALS_INTERVAL_MS=60000

# A request finishing slower than this logs request.slow. Routes that are
# legitimately slow are held to their own timeout instead (container
# start/stop/restart, and the disk-usage routes), so this can stay low without
# warning about normal work.
SLOW_REQUEST_MS=5000

# A metrics poll cycle taking longer than this logs metrics.poll.slow. The
# watchdog only reports once the loop has stopped completely; this is what shows
# it degrading beforehand.
SLOW_POLL_MS=15000

# Ceiling on concurrent `docker` CLI processes. Every poll and every browser
# request can spawn one; under a slow daemon they'd otherwise overlap without
# limit, and the answer to a slow daemon is never to spawn more clients at it.
DOCKER_MAX_CONCURRENT=12

# How long `docker system df` (the Disk panel) may take. It's in a cost class of
# its own: it deduplicates shared image layers by walking the whole overlay2
# tree, which is sub-second on native Linux but was measured at 40-75s cold on a
# WSL2/Docker Desktop host, where the layers sit on a virtual disk behind a
# 9p/virtiofs hop. Warm it drops back to ~3s, so the run-to-run spread is large
# and the default is deliberately far above the typical cost rather than near
# it. Raise this if the Disk panel reports a timeout; the poll also backs off on
# its own when the call keeps failing, so a host where it simply can't complete
# settles at one attempt an hour rather than one a minute.
DISK_USAGE_TIMEOUT_MS=120000
