{
  "name": "opendockwatch",
  "version": "2.9.3",
  "description": "Simple Docker monitoring dashboard - list containers, start/stop/restart, live log tailing. Local + remote hosts over SSH.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "DarkS1D3R",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkS1D3R/OpenDockWatch.git"
  },
  "bugs": {
    "url": "https://github.com/DarkS1D3R/OpenDockWatch/issues"
  },
  "homepage": "https://github.com/DarkS1D3R/OpenDockWatch#readme",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "hash-password": "node scripts/hash-password.js",
    "screenshots": "node scripts/screenshots.js",
    "test": "node scripts/check-syntax.js && node --test --test-force-exit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:logos": "node scripts/build-logos.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "simple-icons": "^16.37.0",
    "supertest": "^7.3.2"
  }
}
